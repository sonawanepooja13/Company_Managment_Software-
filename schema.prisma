generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Cross-Border E-Commerce Platform: China → India
// Prisma ORM Schema
// ============================================================================

// 1. Currency & Exchange Rate
// ----------------------------------------------------------------------------
model Currency {
  code      String   @id @db.Char(3)
  name      String
  symbol    String?  @db.VarChar(8)
  isActive  Boolean  @default(true) @db.Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([isActive])
}

model ExchangeRate {
  id           Int      @id @default(autoincrement())
  fromCurrency String   @db.Char(3)
  toCurrency   String   @db.Char(3)
  rate         Decimal  @db.Decimal(15, 6)
  effectiveAt  DateTime @default(now()) @db.Timestamptz(6)
  source       String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([fromCurrency, toCurrency, effectiveAt])
  @@index([fromCurrency, toCurrency])
  @@index([effectiveAt])
}

// 2. Users / Customers
// ----------------------------------------------------------------------------
enum UserType {
  b2c_customer
  b2b_customer
  admin
  ops
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  userType       UserType  @db.Enum("user_type")
  email          String?   @unique
  phone          String?
  passwordHash   String?   @map("password_hash")
  fullName       String?   @map("full_name")
  companyName    String?   @map("company_name")
  gstNumber      String?   @db.VarChar(15) @map("gst_number")
  billingAddr    Json?     @map("billing_addr") @db.JsonB
  shippingAddr   Json?     @map("shipping_addr") @db.JsonB
  isVerified     Boolean   @default(false) @map("is_verified")
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  // Relations
  orders        Order[]
  payments      Payment[]
  taxInvoices   TaxInvoice[]
  inventoryMovements InventoryMovement[]
  landingCosts  LandingCost[]

  @@index([email])
  @@index([phone])
  @@index([gstNumber])
  @@index([userType])
}

// 3. Suppliers (China)
// ----------------------------------------------------------------------------
model SupplierContact {
  id          Int     @id @default(autoincrement())
  supplierId  String  @map("supplier_id") @db.Uuid
  name        String
  designation String?
  email       String?
  phone       String?
  wechatId    String? @map("wechat_id")
  isPrimary   Boolean @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([supplierId])
}

model Supplier {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  companyName     String?  @map("company_name")
  countryCode     String   @default("CN") @db.Char(2) @map("country_code")
  address         Json?
  email           String?
  phone           String?
  wechat          String?
  alibabaId       String?  @map("alibaba_id")
  paymentTerms    String?  @map("payment_terms")
  leadTimeDays    Int?     @map("lead_time_days")
  isPreferred     Boolean  @default(false) @map("is_preferred")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  contacts        SupplierContact[]
  shipments       ImportShipment[]

  @@index([name])
  @@index([isPreferred])
}

// 4. Categories & HSN Codes
// ----------------------------------------------------------------------------
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  parentId    Int?     @map("parent_id")
  hsnChapter  String?  @db.VarChar(2) @map("hsn_chapter")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  // Self-relation
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  // Relations
  products Product[]

  @@index([parentId])
  @@index([hsnChapter])
}

// 5. Products (with Indian compliance fields)
// ----------------------------------------------------------------------------
enum ProductStatus {
  draft
  pending_approval
  approved
  rejected
  discontinued
}

model Product {
  id                String         @id @default(uuid()) @db.Uuid
  sku               String         @unique
  name              String
  description       String?
  categoryId        Int?           @map("category_id")
  brand             String?
  countryOfOrigin   String         @default("CN") @db.Char(2) @map("country_of_origin")
  hsnCode           String         @db.VarChar(8) @map("hsn_code")
  gstSlab           Decimal        @db.Decimal(5, 2) @map("gst_slab")
  mrp               Decimal        @db.Decimal(10, 2)
  bisCertRequired   Boolean        @default(false) @map("bis_cert_required")
  bisCertNumber     String?        @map("bis_cert_number")
  bisCertValid      DateTime?      @db.Date @map("bis_cert_valid")
  isBisCertified    Boolean        @default(false) @map("is_bis_certified")
  isHazardous       Boolean        @default(false) @map("is_hazardous")
  dimensionsCm      Json?          @map("dimensions_cm") @db.JsonB
  weightKg          Decimal?       @db.Decimal(10, 3) @map("weight_kg")
  volumeCbm         Decimal?       @db.Decimal(10, 3) @map("volume_cbm")
  procurementCostCny Decimal?      @map("procurement_cost_cny") @db.Decimal(15, 2)
  procurementCostUsd Decimal?      @map("procurement_cost_usd") @db.Decimal(15, 2)
  status            ProductStatus  @default(draft)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)

  // Relations
  category     Category?          @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  shipmentItems ImportShipmentItem[]
  inventory    Inventory[]
  orderItems   OrderItem[]
  landingCosts LandingCost[]
  movements    InventoryMovement[]

  @@index([categoryId])
  @@index([countryOfOrigin])
  @@index([hsnCode])
  @@index([status])
  @@index([bisCertNumber])
  @@index([status, hsnCode])
}

model ProductImage {
  id          Int      @id @default(autoincrement())
  productId   String   @map("product_id") @db.Uuid
  imageUrl    String   @map("image_url")
  altText     String?  @map("alt_text")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// 6. Import Shipments (China → India)
// ----------------------------------------------------------------------------
enum ShipmentStatus {
  pending
  booked
  in_transit
  at_destination
  customs_hold
  released
  delivered
  cancelled
}

model ImportShipment {
  id                   String   @id @default(uuid()) @db.Uuid
  shipmentNumber       String   @unique @map("shipment_number")
  supplierId           String?  @map("supplier_id") @db.Uuid
  invoiceNumber        String?  @map("invoice_number")
  invoiceAmountCny     Decimal? @map("invoice_amount_cny") @db.Decimal(15, 2)
  invoiceAmountUsd     Decimal? @map("invoice_amount_usd") @db.Decimal(15, 2)
  invoiceCurrency      String   @db.Char(3) @default("USD") @map("invoice_currency")
  invoiceDate          DateTime @db.Date @map("invoice_date")
  purchaseOrderId      String?  @map("purchase_order_id") @db.Uuid
  freightCostInr       Decimal  @db.Decimal(12, 2) @map("freight_cost_inr")
  insuranceCostInr     Decimal? @db.Decimal(12, 2) @map("insurance_cost_inr")
  portChargesInr       Decimal  @db.Decimal(12, 2) @map("port_charges_inr")
  blAwbNumber          String?  @map("bl_awb_number")
  vesselFlight         String?  @map("vessel_flight")
  originPort           String?  @map("origin_port")
  destinationPort      String?  @map("destination_port")
  etd                DateTime? @db.Date @map("etd")
  eta                DateTime? @db.Date @map("eta")
  ata                DateTime? @db.Date @map("ata")
  status             ShipmentStatus @default(pending)
  customsDeclarationNumber String? @map("customs_declaration_number")
  createdAt          DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt          DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  // Relations
  supplier      Supplier?              @relation(fields: [supplierId], references: [id])
  items         ImportShipmentItem[]
  landingCosts  LandingCost[]

  @@index([supplierId])
  @@index([status])
  @@index([eta])
  @@index([invoiceNumber])
  @@index([blAwbNumber])
}

model ImportShipmentItem {
  id              Int      @id @default(autoincrement())
  shipmentId      String   @map("shipment_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  quantity        Decimal  @db.Decimal(12, 3)
  unitPriceCny    Decimal? @map("unit_price_cny") @db.Decimal(10, 2)
  unitPriceUsd    Decimal? @map("unit_price_usd") @db.Decimal(10, 2)
  lineTotalCny    Decimal? @map("line_total_cny") @db.Decimal(15, 2)
  lineTotalUsd    Decimal? @map("line_total_usd") @db.Decimal(15, 2)
  hsnCode         String?  @db.VarChar(8) @map("hsn_code")
  countryOfOrigin String?  @db.Char(2) @map("country_of_origin")

  // Relations
  shipment  ImportShipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id])
  landingCosts LandingCost[]

  @@unique([shipmentId, productId, hsnCode])
  @@index([shipmentId])
  @@index([productId])
}

// 7. Warehouses & Inventory
// ----------------------------------------------------------------------------
model Warehouse {
  id           Int      @id @default(autoincrement())
  name         String
  code         String   @unique @db.VarChar(10)
  address      String?
  city         String?
  state        String?
  pinCode      String?  @db.VarChar(6) @map("pin_code")
  country      String   @default("IN") @db.Char(2)
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  capacityCbm  Decimal? @map("capacity_cbm") @db.Decimal(12, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  // Relations
  inventory             Inventory[]
  pincodeServiceability PincodeServiceability[]

  @@index([code])
  @@index([pinCode])
}

enum InventoryStatus {
  on_hand
  in_transit
  at_port
  on_hold
}

model Inventory {
  id            Int            @id @default(autoincrement())
  productId     String         @map("product_id") @db.Uuid
  warehouseId   Int?           @map("warehouse_id")
  status        InventoryStatus @default(on_hand)
  quantity      Decimal        @db.Decimal(12, 3) @default(0)
  reservedQty   Decimal        @default(0) @map("reserved_qty") @db.Decimal(12, 3)
  lastRestocked DateTime?      @map("last_restocked") @db.Timestamptz(6)
  shipmentItemId Int?          @map("shipment_item_id")
  createdAt     DateTime       @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6) @map("updated_at")

  // Relations
  product       Product            @relation(fields: [productId], references: [id])
  warehouse     Warehouse?         @relation(fields: [warehouseId], references: [id])
  shipmentItem  ImportShipmentItem? @relation(fields: [shipmentItemId], references: [id])
  orderItems    OrderItem[]

  @@index([productId])
  @@index([warehouseId])
  @@index([status])
  @@unique([productId, warehouseId, status])
}

model InventoryMovement {
  id            Int              @id @default(autoincrement())
  productId     String           @map("product_id") @db.Uuid
  warehouseId   Int?             @map("warehouse_id")
  shipmentItemId Int?            @map("shipment_item_id")
  fromStatus    InventoryStatus  @map("from_status")
  toStatus      InventoryStatus  @map("to_status")
  quantity      Decimal          @db.Decimal(12, 3)
  reason        String?
  referenceId   String?          @map("reference_id")
  createdAt     DateTime         @default(now()) @db.Timestamptz(6) @map("created_at")
  createdBy     String?          @map("created_by") @db.Uuid

  // Relations
  product    Product     @relation(fields: [productId], references: [id])
  warehouse  Warehouse?  @relation(fields: [warehouseId], references: [id])
  user       User?       @relation(fields: [createdBy], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@index([referenceId])
}

// 8. PIN Code Serviceability
// ----------------------------------------------------------------------------
model PincodeServiceability {
  id             Int      @id @default(autoincrement())
  pinCode        String   @unique @db.VarChar(6) @map("pin_code")
  state          String?
  district       String?
  city           String?
  postalDivision  String? @map("postal_division")
  isServiceable  Boolean  @default(true) @map("is_serviceable")
  deliveryDays   Int?     @map("delivery_days")
  codAvailable   Boolean  @default(false) @map("cod_available")
  minOrderValue  Decimal? @map("min_order_value") @db.Decimal(10, 2)
  maxOrderValue  Decimal? @map("max_order_value") @db.Decimal(10, 2)
  shippingCharge Decimal? @map("shipping_charge") @db.Decimal(10, 2)
  warehouseId    Int?     @map("warehouse_id")
  updatedAt      DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  // Relations
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([isServiceable])
  @@index([warehouseId])
}

// 9. Landing Cost Calculation
// ----------------------------------------------------------------------------
model LandingCost {
  id                Int      @id @default(autoincrement())
  productId         String   @map("product_id") @db.Uuid
  shipmentId        String   @map("shipment_id") @db.Uuid
  shipmentItemId    Int?     @map("shipment_item_id")

  // Raw costs
  procurementUsd    Decimal? @map("procurement_usd") @db.Decimal(14, 4)
  procurementCny    Decimal? @map("procurement_cny") @db.Decimal(14, 4)
  procurementInr    Decimal? @map("procurement_inr") @db.Decimal(14, 2)
  exchangeRate      Decimal? @map("exchange_rate") @db.Decimal(12, 4)
  exchangeRateDate  DateTime? @map("exchange_rate_date") @db.Date

  // Freight & port
  freightInr        Decimal  @map("freight_inr") @db.Decimal(12, 2)
  portChargesInr    Decimal  @map("port_charges_inr") @db.Decimal(12, 2)

  // Calculated components
  cifBaseInr        Decimal  @map("cif_base_inr") @db.Decimal(14, 2)
  bcdRate           Decimal  @map("bcd_rate") @db.Decimal(5, 3)
  bcdAmountInr      Decimal  @map("bcd_amount_inr") @db.Decimal(14, 2)
  swsRate           Decimal  @map("sws_rate") @db.Decimal(5, 3)
  swsAmountInr      Decimal  @map("sws_amount_inr") @db.Decimal(14, 2)
  igstRate          Decimal  @map("igst_rate") @db.Decimal(5, 3)
  igstAmountInr     Decimal  @map("igst_amount_inr") @db.Decimal(14, 2)
  totalLandingCostInr Decimal  @map("total_landing_cost_inr") @db.Decimal(14, 2)

  calculatedAt      DateTime @default(now()) @db.Timestamptz(6) @map("calculated_at")
  calculatedBy      String?  @map("calculated_by") @db.Uuid

  // Relations
  product       Product             @relation(fields: [productId], references: [id])
  shipment      ImportShipment      @relation(fields: [shipmentId], references: [id])
  shipmentItem  ImportShipmentItem? @relation(fields: [shipmentItemId], references: [id])
  user          User?               @relation(fields: [calculatedBy], references: [id])

  @@unique([productId, shipmentId])
  @@index([productId])
  @@index([shipmentId])
  @@index([calculatedAt])
}

// 10. Orders (B2C / B2B)
// ----------------------------------------------------------------------------
enum OrderStatus {
  pending
  confirmed
  processing
  packed
  shipped
  out_for_delivery
  delivered
  cancelled
  returned
  refunded
}

model Order {
  id              String   @id @default(uuid()) @db.Uuid
  orderNumber     String   @unique @map("order_number")
  userId          String   @map("user_id") @db.Uuid
  orderType       String   @db.Char(4) @map("order_type")
  status          OrderStatus @default(pending)
  currency        String   @default("INR") @db.Char(3)
  subtotalInr     Decimal  @map("subtotal_inr") @db.Decimal(14, 2)
  shippingInr     Decimal  @map("shipping_inr") @db.Decimal(10, 2)
  discountInr     Decimal  @default(0) @map("discount_inr") @db.Decimal(10, 2)
  taxAmountInr    Decimal  @map("tax_amount_inr") @db.Decimal(10, 2)
  roundOffInr     Decimal? @map("round_off_inr") @db.Decimal(10, 2)
  totalInr        Decimal  @map("total_inr") @db.Decimal(14, 2)
  shippingAddress Json?    @map("shipping_address") @db.JsonB
  billingAddress  Json?    @map("billing_address") @db.JsonB
  pinCode         String?  @db.VarChar(6) @map("pin_code")
  deliveryDate    DateTime? @map("delivery_date") @db.Date
  courierName     String?  @map("courier_name")
  trackingNumber  String?  @map("tracking_number")
  paymentMethod   String?  @map("payment_method")
  paymentStatus   String   @default("pending") @map("payment_status")
  placeOfSupply   String?  @map("place_of_supply")
  gstStateCode    String?  @db.VarChar(2) @map("gst_state_code")
  notes           String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  // Relations
  user       User          @relation(fields: [userId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  taxInvoice TaxInvoice[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([pinCode])
  @@index([paymentStatus])
}

model OrderItem {
  id                    Int      @id @default(autoincrement())
  orderId               String   @map("order_id") @db.Uuid
  productId             String   @map("product_id") @db.Uuid
  inventoryId           Int?     @map("inventory_id")
  quantity              Int
  unitPriceInr          Decimal  @map("unit_price_inr") @db.Decimal(10, 2)
  landingCostInr        Decimal? @map("landing_cost_inr") @db.Decimal(10, 2)
  discountPerItemInr    Decimal  @default(0) @map("discount_per_item_inr") @db.Decimal(10, 2)
  lineTotalInr          Decimal  @map("line_total_inr") @db.Decimal(14, 2)
  hsnCode               String   @db.VarChar(8) @map("hsn_code")
  gstSlab               Decimal  @map("gst_slab") @db.Decimal(5, 2)
  cgstAmountInr         Decimal  @default(0) @map("cgst_amount_inr") @db.Decimal(10, 2)
  sgstAmountInr         Decimal  @default(0) @map("sgst_amount_inr") @db.Decimal(10, 2)
  igstAmountInr         Decimal  @default(0) @map("igst_amount_inr") @db.Decimal(10, 2)
  taxableAmountInr      Decimal  @map("taxable_amount_inr") @db.Decimal(10, 2)

  // Relations
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id])
  inventory  Inventory? @relation(fields: [inventoryId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([hsnCode])
}

// 11. Tax Invoices (GST Compliance)
// ----------------------------------------------------------------------------
enum InvoiceType {
  b2b
  b2cl
  b2cs
  export
}

model TaxInvoice {
  id               String   @id @default(uuid()) @db.Uuid
  invoiceNumber    String   @unique @map("invoice_number")
  invoiceType      InvoiceType @map("invoice_type")
  orderId          String   @map("order_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  invoiceDate      DateTime @db.Date
  dueDate          DateTime? @map("due_date") @db.Date
  customerName     String? @map("customer_name")
  customerGstin    String?  @db.VarChar(15) @map("customer_gstin")
  customerStateCode String? @db.VarChar(2) @map("customer_state_code")
  customerAddress  String? @map("customer_address")
  taxableAmount    Decimal  @map("taxable_amount") @db.Decimal(14, 2)
  cgstTotal        Decimal  @default(0) @map("cgst_total") @db.Decimal(10, 2)
  sgstTotal        Decimal  @default(0) @map("sgst_total") @db.Decimal(10, 2)
  igstTotal        Decimal  @default(0) @map("igst_total") @db.Decimal(10, 2)
  totalAmount      Decimal  @map("total_amount") @db.Decimal(14, 2)
  placeOfSupply    String? @map("place_of_supply")
  hsnCodesSummary  Json?   @map("hsn_codes_summary") @db.JsonB
  bisCertReferences Json?  @map("bis_cert_references") @db.JsonB
  irn              String? @map("irn")
  irnDate          DateTime? @map("irn_date") @db.Date
  qrCode           String? @map("qr_code")
  isCancelled      Boolean @default(false) @map("is_cancelled")
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  createdBy        String? @map("created_by") @db.Uuid

  // Relations
  order   Order @relation(fields: [orderId], references: [id])
  user    User  @relation(fields: [userId], references: [id])

  @@index([invoiceDate])
  @@index([customerGstin])
  @@index([invoiceType])
  @@index([irn])
  @@index([orderId])
}

// 12. Payments
// ----------------------------------------------------------------------------
enum PaymentProvider {
  razorpay
  stripe
  paypal
  cod
  bank_transfer
  card
}

model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  amountInr      Decimal  @map("amount_inr") @db.Decimal(14, 2)
  provider       PaymentProvider
  providerTxnId  String?  @map("provider_txn_id")
  status         String
  paymentMethod  String?  @map("payment_method")
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  refundedAt     DateTime? @map("refunded_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([providerTxnId])
}

// 13. Audit Log
// ----------------------------------------------------------------------------
model AuditLog {
  id          Int      @id @default(autoincrement())
  tableName   String   @map("table_name")
  recordId    String?  @map("record_id")
  action      String
  oldValues   Json?    @map("old_values") @db.JsonB
  newValues   Json?    @map("new_values") @db.JsonB
  changedBy   String?  @map("changed_by") @db.Uuid
  changedAt   DateTime @default(now()) @db.Timestamptz(6) @map("changed_at")
  ipAddress   String?  @map("ip_address")

  @@index([tableName])
  @@index([changedAt])
  @@index([changedBy])
}
